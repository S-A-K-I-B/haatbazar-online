# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string
DATABASE_URL="postgresql://haatbazar:haatbazar@localhost:5432/haatbazar?schema=public"

# Long, random, secret strings — generate with `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Public URL of the deployed frontend (used for CORS + cookie settings)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development

# How long each player has to act on their turn before the server auto-passes
TURN_TIME_LIMIT_SECONDS=60
